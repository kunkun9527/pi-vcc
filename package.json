{
  "name": "@monotykamary/pi-vcc",
  "version": "0.8.15",
  "description": "Deterministic Pi context compactor with Chinese support, evidence-backed memory, optional Jev ranking, and history recall",
  "main": "index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vcc",
    "compact",
    "compaction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunkun9527/pi-vcc.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "knip": "6.14.1",
    "typescript": "6.0.3",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "vitest": "4.1.7",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "typebox": "1.3.27",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "scripts": {
    "test:host": "node scripts/pi1-host.mjs",
    "typecheck": "tsc --noEmit",
    "lint:dead": "knip",
    "test": "PI_FABRIC_COMPACTION_ENGINE= bun test ./tests --path-ignore-patterns '**/real-sessions.test.ts' && bun run test:regression",
    "test:regression": "vitest run __tests__"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "homepage": "https://github.com/kunkun9527/pi-vcc",
  "bugs": {
    "url": "https://github.com/kunkun9527/pi-vcc/issues"
  }
}
